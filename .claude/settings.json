{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git diff)",
      "Bash(git diff:*)",
      "Bash(git log)",
      "Bash(git log:*)",
      "Bash(git show)",
      "Bash(git show:*)",
      "Bash(git branch)",
      "Bash(git branch --show-current)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.dev)",
      "Read(./.env.development)",
      "Read(./.env.test)",
      "Read(./.env.testing)",
      "Read(./.env.sandbox)",
      "Read(./.env.demo)",
      "Read(./.env.staging)",
      "Read(./.env.prod)",
      "Read(./.env.production)",
      "Read(./.env.backup)"
    ]
  }
}
